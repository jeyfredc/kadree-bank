                                      ],
                         "index":  "b2w",
                         "isDeleted":  false,
                         "lineHeight":  1.25,
                         "link":  null,
                         "locked":  false,
                         "opacity":  100,
                         "originalText":  "CONCURRENCIA DEL SALDO (bloqueo pesimista de fila)\n1. CuentaService abre una transacción con ICuentaRepositorio.EnTransaccion().\n2. ObtenerParaActualizar() bloquea SOLO la fila de esa cuenta (SELECT ... FOR UPDATE, con tiempo de espera de 5 s).\n3. Cuenta.Retirar() / Consignar() valida y cambia el saldo; Guardar() persiste saldo + movimiento; el COMMIT libera el bloqueo.\n=\u003e Operaciones sobre la misma cuenta se hacen una tras otra; cuentas distintas corren en paralelo. Si vence la espera: 409, reintentar.",
                         "roughness":  1,
                         "roundness":  null,
                         "seed":  1544954884,
                         "strokeColor":  "#1e1e1e",
                         "strokeStyle":  "solid",
                         "strokeWidth":  2,
                         "text":  "CONCURRENCIA DEL SALDO (bloqueo pesimista de fila)\n1. CuentaService abre una transacción con ICuentaRepositorio.EnTransaccion().\n2. ObtenerParaActualizar() bloquea SOLO la fila de esa cuenta (SELECT ... FOR UPDATE, con tiempo de espera de 5 s).\n3. Cuenta.Retirar() / Consignar() valida y cambia el saldo; Guardar() persiste saldo + movimiento; el COMMIT libera el bloqueo.\n=\u003e Operaciones sobre la misma cuenta se hacen una tras otra; cuentas distintas corren en paralelo. Si vence la espera: 409, reintentar.",
                         "textAlign":  "left",
                         "updated":  1791572243204,
                         "version":  1,
                         "versionNonce":  318774046,
                         "verticalAlign":  "top"
                     },
