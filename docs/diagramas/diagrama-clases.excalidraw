                         "link":  null,
                         "locked":  false,
                         "opacity":  100,
                         "originalText":  "REGLA: SALDO NUNCA NEGATIVO\n- Se valida en Cuenta.Retirar()\n  (dominio, antes de guardar).\n- Monto \u003e 0 en ValidarMonto().\n- Respaldo en la BD:\n  CHECK (saldo \u003e= 0).",
                         "roughness":  1,
                         "roundness":  null,
                         "seed":  1587491850,
                         "strokeColor":  "#1e1e1e",
                         "strokeStyle":  "solid",
                         "strokeWidth":  2,
                         "text":  "REGLA: SALDO NUNCA NEGATIVO\n- Se valida en Cuenta.Retirar()\n  (dominio, antes de guardar).\n- Monto \u003e 0 en ValidarMonto().\n- Respaldo en la BD:\n  CHECK (saldo \u003e= 0).",
                         "textAlign":  "left",
                         "updated":  1791572243204,
