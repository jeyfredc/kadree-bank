# Copie este archivo como .env y ajuste los valores.  cp .env.example .env

# Base de datos (no use ';' en la contraseña: va dentro de la cadena de conexión)
POSTGRES_DB=kadreebank
POSTGRES_USER=kadree
POSTGRES_PASSWORD=cambie_esta_clave

# Puertos publicados en su máquina
DB_PORT=5433
API_PORT=8080
WEB_PORT=4200

# API
BANK_TIMEZONE=America/Bogota
SWAGGER_ENABLED=true
ASPNETCORE_ENVIRONMENT=Production
# Solo si sirve el frontend desde otro origen (separados por coma)
CORS_ALLOWED_ORIGINS=

# Seguridad (OBLIGATORIOS). Genere valores aleatorios largos, por ejemplo con:
#   openssl rand -base64 48
# JWT_KEY firma los tokens (mínimo 32 caracteres).
JWT_KEY=cambie_por_una_clave_aleatoria_de_al_menos_32_caracteres
# PIN_PEPPER protege las contraseñas de 4 dígitos (mínimo 32 caracteres).
# Si lo cambia, las contraseñas existentes dejan de funcionar.
PIN_PEPPER=cambie_por_otro_valor_aleatorio_de_al_menos_32_caracteres

# Contraseña de 4 dígitos que se asigna a los usuarios de prueba (solo desarrollo/demostración).
# Déjela vacía en producción.
DEMO_PIN=2580
